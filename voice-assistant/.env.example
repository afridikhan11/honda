# Is file ki copy bana kar naam ".env" rakhein aur apni key daalein.
# Free key: https://aistudio.google.com/apikey  (Google account se login -> Create API key)
GEMINI_API_KEY=yahan-apni-key-paste-karein

# Model (free tier wala). Had khatam ho to "gemini-2.5-flash-lite" try karein.
GEMINI_MODEL=gemini-2.5-flash

# Bolne ka button
HOTKEY=f9

# Sunne ki zabaan: ur-PK (Urdu) ya en-IN (English / Roman Urdu)
LISTEN_LANGUAGE=ur-PK
# Jawab ki awaaz: ur-PK-AsadNeural (mard) ya ur-PK-UzmaNeural (aurat)
SPEAK_VOICE=ur-PK-AsadNeural

ANONYMIZED_TELEMETRY=false
